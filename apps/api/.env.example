# Copy to apps/api/.env and fill in.
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/tesseract-prints

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# 32-byte key for AES-256-GCM file encryption, as 64 hex characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_ENCRYPTION_KEY=

# Where the web app runs (used for CORS and payment return links)
WEB_URL=http://localhost:5173

# Payments. PAYMENT_PROVIDER picks the gateway for new checkouts: bachs (default) or paystack.
# Orders already sent to the other gateway still confirm through it, so keep its keys set while switching over.
# Leave the active gateway's key empty in development to use mock payments (never allowed in production).
PAYMENT_PROVIDER=bachs

# Bachs (https://app.bachs.io → Developer Portal). sk_sandbox_ keys use the sandbox, sk_live_ keys go live.
# The webhook signing secret is on the endpoint's page in Developer Portal → Webhooks. Required in production.
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
# Optional override of the API base URL (normally derived from the key)
# BACHS_API_URL=https://api.bachs.io

# Paystack secret key (fallback gateway)
PAYSTACK_SECRET_KEY=

# Monthly invoices for account organisations. On the 1st (Lagos time) each organisation is invoiced for the
# previous month's orders, due in 14 days, payable online through the payment gateway above.
# BILLING_START: first month (YYYY-MM) to invoice. Orders before it were settled outside the app and are never billed.
BILLING_START=2026-10
# Optional bank transfer details printed on invoices. Use \n for line breaks.
BILLING_BANK_DETAILS=

# Email. Set ONE of RESEND_API_KEY (https://resend.com) or SMTP_URL (any provider, e.g. Zoho, Google Workspace,
# Mailgun, Amazon SES): smtps://user:password@smtp.example.com:465
# With neither set, emails are written to the log and recorded in the console's outbox as "skipped".
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM=Tesseract Prints <orders@tesseractprints.com>
EMAIL_REPLY_TO=
# Print-room inbox for new-order and enquiry alerts
OPS_EMAIL=

# Optional: serve the built web app from the API in production
# WEB_DIST=../web/dist

# Used by `npm run seed`
SEED_OWNER_EMAIL=owner@demo-chambers.ng
SEED_OPERATOR_EMAIL=operator@tesseractprints.com
SEED_PASSWORD=
